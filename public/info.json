{
  "appcast": "https://raw.githubusercontent.com/openai-translator/bob-plugin-openai-translator/main/appcast.json",
  "author": "yetone <yetoneful@gmail.com>",
  "category": "translate",
  "homepage": "https://github.com/openai-translator/bob-plugin-openai-translator",
  "icon": "",
  "identifier": "yetone.openai.translator",
  "minBobVersion": "1.8.0",
  "name": "OpenAI Translator",
  "options": [
    {
      "defaultValue": "openai",
      "identifier": "serviceProvider",
      "menuValues": [
        {
          "title": "OpenAI",
          "value": "openai"
        },
        {
          "title": "OpenAI Compatible",
          "value": "openai-compatible"
        },
        {
          "title": "Azure OpenAI",
          "value": "azure-openai"
        },
        {
          "title": "Google Gemini",
          "value": "gemini"
        },
        {
          "title": "MiniMax",
          "value": "minimax"
        }
      ],
      "title": "Service Provider",
      "type": "menu"
    },
    {
      "desc": "OpenAI: https://api.openai.com\n\nOpenAI Compatible: https://your-gateway.com\n\nAzure OpenAI: https://RESOURCE_NAME.openai.azure.com\n\nGoogle Gemini: https://generativelanguage.googleapis.com/v1beta/models\n\nMiniMax: https://api.minimax.io (default, leave empty)",
      "identifier": "apiUrl",
      "textConfig": {
        "height": "55",
        "placeholderText": "https://api.openai.com",
        "type": "visible"
      },
      "title": "API Base URL",
      "type": "text"
    },
    {
      "desc": "拼接在 Base URL 后面。默认使用 /v1/responses\n\nOpenAI: /v1/chat/completions\n\nAzure OpenAI: /openai/deployments/DEPLOYMENT_NAME/responses?api-version=previews\n\nGoogle Gemini: 不支持，留空即可",
      "identifier": "apiPath",
      "textConfig": {
        "placeholderText": "/v1/responses",
        "type": "visible"
      },
      "title": "API Path",
      "type": "text"
    },
    {
      "desc": "必填项。可以用英文逗号分割多个 API KEY 以实现额度加倍及负载均衡",
      "identifier": "apiKeys",
      "textConfig": {
        "height": "40",
        "placeholderText": "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "type": "secure"
      },
      "title": "API KEY",
      "type": "text"
    },
    {
      "defaultValue": "gpt-5.4-mini",
      "identifier": "model",
      "menuValues": [
        {
          "title": "自定义模型",
          "value": "custom"
        },
        {
          "title": "gpt-5.4",
          "value": "gpt-5.4"
        },
        {
          "title": "gpt-5.4-mini",
          "value": "gpt-5.4-mini"
        },
        {
          "title": "gpt-5.4-nano",
          "value": "gpt-5.4-nano"
        },
        {
          "title": "gemini-3-flash-preview",
          "value": "gemini-3-flash-preview"
        },
        {
          "title": "gemini-2.5-flash",
          "value": "gemini-2.5-flash"
        },
        {
          "title": "MiniMax-M3",
          "value": "MiniMax-M3"
        },
        {
          "title": "MiniMax-M2.7",
          "value": "MiniMax-M2.7"
        },
        {
          "title": "MiniMax-M2.7-highspeed",
          "value": "MiniMax-M2.7-highspeed"
        }
      ],
      "title": "模型",
      "type": "menu"
    },
    {
      "desc": "可选项。当模型选择「自定义模型」时，此项为必填项。请填写有效的模型名称",
      "identifier": "customModel",
      "textConfig": {
        "placeholderText": "gpt-5.4",
        "type": "visible"
      },
      "title": "自定义模型",
      "type": "text"
    },
    {
      "defaultValue": "0.2",
      "desc": "可选项。温度值越高，生成的文本越随机。默认值为 0.2",
      "identifier": "temperature",
      "textConfig": {
        "placeholderText": "0.2",
        "type": "visible"
      },
      "title": "温度",
      "type": "text"
    },
    {
      "defaultValue": "enable",
      "identifier": "stream",
      "menuValues": [
        {
          "title": "Enable",
          "value": "enable"
        },
        {
          "title": "Disable",
          "value": "disable"
        }
      ],
      "title": "流式输出",
      "type": "menu"
    },
    {
      "defaultValue": "disable",
      "desc": "仅 GPT-5 系列和 Gemini 2.5/3 系列支持此设置。由于 API 限制，GPT-5 系列无法完全禁用推理，Disable 仅将推理降至最低级别以减少延迟和 token 消耗",
      "identifier": "thinkingMode",
      "menuValues": [
        {
          "title": "Disable",
          "value": "disable"
        },
        {
          "title": "Enable",
          "value": "enable"
        }
      ],
      "title": "深度思考",
      "type": "menu"
    },
    {
      "defaultValue": "You are a translation engine that can only translate text and cannot interpret it.",
      "desc": "可选项。自定义 System Prompt，填写则会覆盖默认的 System Prompt。自定义 Prompt可使用以下变量：\n\n`$text` - 需要翻译的文本，即翻译窗口输入框内的文本 `$sourceLang` - 原文语言，即翻译窗口输入框内文本的语言，比如「简体中文」\n\n`$targetLang` - 目标语言，即需要翻译成的语言，可以在翻译窗口中手动选择或自动检测，例如「English」",
      "identifier": "customSystemPrompt",
      "textConfig": {
        "height": "100",
        "keyWords": ["$text", "$sourceLang", "$targetLang"],
        "placeholderText": "You are a translation engine that can only translate text and cannot interpret it.",
        "type": "visible"
      },
      "title": "系统指令",
      "type": "text"
    },
    {
      "defaultValue": "translate from $sourceLang to $targetLang:\n\n$text",
      "desc": "可选项。自定义 User Prompt，填写则会覆盖默认的 User Prompt，默认值为`$text`（即翻译窗口输入框内的文本）。\n\n自定义 Prompt 中可以使用与系统指令中相同的变量",
      "identifier": "customUserPrompt",
      "textConfig": {
        "height": "100",
        "keyWords": ["$text", "$sourceLang", "$targetLang"],
        "placeholderText": "translate from $sourceLang to $targetLang:\n\n$text",
        "type": "visible"
      },
      "title": "用户指令",
      "type": "text"
    }
  ],
  "summary": "AI powered translator",
  "version": "4.3.2"
}

{
  "name": "bob-plugin-openai-translator",
  "version": "5.0.0",
  "private": true,
  "description": "Multi-provider AI translation, polishing, and grammar correction for Bob.",
  "type": "module",
  "license": "CC BY-NC-SA 4.0",
  "main": "dist/main.js",
  "keywords": [
    "bob-plugin",
    "openai",
    "translator"
  ],
  "homepage": "https://github.com/nextai-translator/bob-plugin-openai-translator",
  "scripts": {
    "benchmark": "bun run build && bun scripts/benchmark.mts",
    "build": "bun scripts/build.mts",
    "check:runtime": "bun scripts/check-runtime.mts",
    "lint": "biome check . && tsc --noEmit",
    "lint:fix": "biome check --write . && tsc --noEmit",
    "package": "bun scripts/package.mts",
    "release": "bun scripts/package.mts release",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@bob-translate/types": "1.1.0",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.2.19"
  },
  "dependencies": {
    "eventsource-parser": "3.1.0"
  }
}
